{
  "name": "taskflow",
  "version": "1.0.0",
  "private": true,
  "description": "TaskFlow — gestor de tareas colaborativo. Proyecto del curso de Testing y Calidad de Software.",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix server run build",
    "build:client": "npm --prefix client run build",
    "start": "npm --prefix server start",
    "db:setup": "npm --prefix server run db:setup",
    "db:reset": "npm --prefix server run db:reset",
    "test": "npm --prefix server test",
    "test:coverage": "npm --prefix server run test:coverage",
    "test:contract": "npm --prefix server run test:contract",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:a11y": "playwright test e2e/specs/a11y.spec.ts",
    "scan:security": "bash security/zap/run-zap.sh",
    "typecheck:e2e": "tsc -p e2e/tsconfig.json",
    "lint": "npm --prefix server run lint",
    "postinstall": "npm --prefix server install && npm --prefix client install"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.63.0",
    "@types/node": "20.19.9",
    "concurrently": "9.1.0",
    "typescript": "5.6.3"
  },
  "engines": {
    "node": ">=20"
  }
}
